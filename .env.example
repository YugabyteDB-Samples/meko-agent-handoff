MEKO_API_KEY=
MEKO_DATAPACK_ID=
MEKO_MCP_URL=https://mcp.mekodata.ai/mcp

# Optional. Leave MODEL_PROVIDER empty and researcher.py replays a recorded model
# answer from researcher_example.json, so no model key is needed. To call a model
# instead, set MODEL_PROVIDER to one of the three below and fill in its line(s).
MODEL_PROVIDER=

# anthropic: one API key.
# ANTHROPIC_API_KEY=

# bedrock: standard AWS credentials, and Bedrock model access in that account and
# region. Leave these commented out to use a profile or role you already have.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-west-2
# Temporary credentials, such as SSO, also need:
# AWS_SESSION_TOKEN=

# vertex: no key here. Run `gcloud auth application-default login` once, then:
# VERTEX_PROJECT=
# VERTEX_LOCATION=us-central1
