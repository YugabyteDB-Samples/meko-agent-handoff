MEKO_API_KEY=
MEKO_DATAPACK_ID=
MEKO_MCP_URL=https://mcp.mekodata.ai/mcp

# Optional. Leave MODEL_PROVIDER empty and researcher.py replays a recorded model
# answer from researcher_example.json, so no model key is needed. To call a model
# instead, set MODEL_PROVIDER to one of the three below and fill in its line(s).
MODEL_PROVIDER=

# anthropic: one API key.
# ANTHROPIC_API_KEY=

# bedrock: a Bedrock API key from the AWS console, and the region where your account
# has model access. Leave these commented out to use an AWS profile or role instead.
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_REGION=us-west-1

# vertex: Gemini Enterprise Agent Platform, formerly Vertex AI. No key here. Run
# `gcloud auth application-default login` once, then:
# VERTEX_PROJECT=
# VERTEX_LOCATION=us-central1
